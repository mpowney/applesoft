1 REM *** AUST. 4-WAY TRAFFIC LIGHTS ***
2 REM *** LEFT-HAND DRIVE SIMULATION ***
3 REM *** HORIZONTAL SIGNAL DISPLAY  ***
4 REM *** N+S SIGNALS HAVE TURN ARROWS***
5 REM
6 REM SCREEN: 40 COLS x 24 ROWS
7 REM FOUR HEADS SIDE BY SIDE, NO ROAD
8 REM LAMPS STACKED: RED/AMB/GRN/ARROW
9 REM
10 HOME
15 RR=5 : AR=7 : GR=9 : GAR=11 : AAR=13
20 GOSUB 900
30 GOSUB 2000
40 CP = 1
50 GOSUB 3000
60 GOSUB 4000
70 GOSUB 5000
80 IF QF = 1 THEN GOTO 500
90 CP = CP + 1
100 IF CP > NP THEN CP = 1
110 GOTO 50
500 HOME
510 VTAB 12 : HTAB 10
520 PRINT "SIMULATION ENDED"
530 END
900 REM READ SIGNAL HEAD CONFIG
910 READ NH
920 DIM HC(NH),HA(NH)
930 FOR I = 1 TO NH
940 READ HC(I),HA(I)
950 NEXT I
960 REM READ PHASE CONFIG
970 READ NP
980 DIM PD(NP),PN$(NP),PS(NP,NH)
990 FOR P = 1 TO NP
1000 READ PD(P),PN$(P)
1010 FOR H = 1 TO NH
1020 READ PS(P,H)
1030 NEXT H
1040 NEXT P
1050 RETURN
2000 REM DRAW STATIC SCREEN
2010 HOME
2020 VTAB 1 : HTAB 9
2030 PRINT "AUST. TRAFFIC LIGHT SIM"
2040 VTAB 3 : HTAB 3 : PRINT "NORTH";
2050 HTAB 13 : PRINT "SOUTH";
2060 HTAB 23 : PRINT "WEST";
2070 HTAB 33 : PRINT "EAST"
2080 VTAB 22 : HTAB 1
2090 PRINT "PRESS ANY KEY TO STOP"
2100 RETURN
3000 REM DRAW ALL SIGNAL HEADS
3005 REM STATES: 1=RED 2=AMB 3=GRN 4=GRN ARROW 5=RED+AMB 6=AMB ARROW
3010 FOR DH = 1 TO NH
3020 SC = HC(DH) : SA = HA(DH) : SS = PS(CP,DH)
3030 REM RED LAMP: LIT FOR 1,4,5,6
3040 VTAB RR : HTAB SC
3050 IF SS = 1 OR SS = 4 OR SS = 5 OR SS = 6 THEN INVERSE
3060 PRINT "O" : NORMAL
3070 REM AMBER LAMP: LIT FOR 2,5
3080 VTAB AR : HTAB SC
3090 IF SS = 2 OR SS = 5 THEN INVERSE
3100 PRINT "O" : NORMAL
3110 REM GREEN LAMP: LIT FOR 3
3120 VTAB GR : HTAB SC
3130 IF SS = 3 THEN INVERSE
3140 PRINT "O" : NORMAL
3150 REM ARROW LAMPS: ONLY ON HEADS WITH SA>0
3160 IF SA = 0 THEN GOTO 3290
3170 REM GREEN ARROW: LIT FOR STATE 4
3180 VTAB GAR : HTAB SC
3190 IF SS = 4 THEN INVERSE
3200 IF SA = 1 THEN PRINT "<"
3210 IF SA = 2 THEN PRINT ">"
3220 NORMAL
3230 REM AMBER ARROW: LIT FOR STATE 6
3240 VTAB AAR : HTAB SC
3250 IF SS = 6 THEN INVERSE
3260 IF SA = 1 THEN PRINT "<"
3270 IF SA = 2 THEN PRINT ">"
3280 NORMAL
3290 NEXT DH
3300 RETURN
4000 REM SHOW CURRENT PHASE NAME
4010 VTAB 20 : HTAB 1
4020 PRINT "PHASE: ";PN$(CP);"          "
4030 RETURN
5000 REM TIMED DELAY WITH KEYPRESS CHECK
5010 QF = 0
5020 FOR T = 1 TO PD(CP) * 200
5030 IF PEEK(49152) > 127 THEN POKE 49168,0 : QF = 1 : T = PD(CP) * 200
5040 NEXT T
5050 RETURN
9000 REM *** SIGNAL HEAD CONFIGURATION ***
9005 REM NH = NUMBER OF SIGNAL HEADS
9010 REM FORMAT PER HEAD: COL, ARROW_TYPE
9015 REM ARROW_TYPE: 0=NONE  1=< (WEST)  2=> (EAST)
9020 REM LAMP ROWS: RR=RED AR=AMB GR=GRN GAR=GRN-ARROW AAR=AMB-ARROW
9025 DATA 4
9030 REM SIG 1: NORTH APPROACH - SOUTHBOUND DRIVERS, RIGHT TURN = WEST (<)
9035 DATA 5,1
9040 REM SIG 2: SOUTH APPROACH - NORTHBOUND DRIVERS, RIGHT TURN = EAST (>)
9045 DATA 15,2
9050 REM SIG 3: WEST APPROACH - EASTBOUND DRIVERS, NO PROTECTED TURN
9055 DATA 25,0
9060 REM SIG 4: EAST APPROACH - WESTBOUND DRIVERS, NO PROTECTED TURN
9065 DATA 35,0
9070 REM *** PHASE CONFIGURATION ***
9075 REM NP = NUMBER OF PHASES
9080 REM FORMAT: DURATION, NAME, N_ST, S_ST, W_ST, E_ST
9085 REM STATES: 1=RED  2=AMB  3=GRN  4=GRN-ARROW  5=RED+AMB  6=AMB-ARROW
9090 REM SIGNAL ORDER IN EACH PHASE: NORTH, SOUTH, WEST, EAST
9095 DATA 14
9100 REM PHASE 1: N-S PREPARE (RED+AMBER = AUSTRALIAN PRE-GREEN SIGNAL)
9105 DATA 5,"NS PREP",5,5,1,1
9110 REM PHASE 2: N-S GREEN - STRAIGHT AHEAD AND FREE LEFT TURNS
9115 DATA 50,"NS GREEN",3,3,1,1
9120 REM PHASE 3: N-S AMBER - PREPARE TO STOP
9125 DATA 15,"NS AMBER",2,2,1,1
9130 REM PHASE 4: ALL RED CLEARANCE INTERVAL
9135 DATA 5,"ALL RED",1,1,1,1
9140 REM PHASE 5: NORTH GREEN ARROW - PROTECTED RIGHT TURN (SOUTHBOUND TO WEST)
9145 DATA 20,"N ARROW",4,1,1,1
9150 REM PHASE 6: NORTH AMBER ARROW - END OF PROTECTED RIGHT TURN
9155 DATA 8,"N ARW AMB",6,1,1,1
9160 REM PHASE 7: ALL RED CLEARANCE
9165 DATA 5,"ALL RED",1,1,1,1
9170 REM PHASE 8: SOUTH GREEN ARROW - PROTECTED RIGHT TURN (NORTHBOUND TO EAST)
9175 DATA 20,"S ARROW",1,4,1,1
9180 REM PHASE 9: SOUTH AMBER ARROW - END OF PROTECTED RIGHT TURN
9185 DATA 8,"S ARW AMB",1,6,1,1
9190 REM PHASE 10: ALL RED CLEARANCE
9195 DATA 5,"ALL RED",1,1,1,1
9200 REM PHASE 11: E-W PREPARE (RED+AMBER = AUSTRALIAN PRE-GREEN SIGNAL)
9205 DATA 5,"EW PREP",1,1,5,5
9210 REM PHASE 12: E-W GREEN - STRAIGHT AHEAD AND FREE LEFT TURNS
9215 DATA 50,"EW GREEN",1,1,3,3
9220 REM PHASE 13: E-W AMBER - PREPARE TO STOP
9225 DATA 15,"EW AMBER",1,1,2,2
9230 REM PHASE 14: ALL RED CLEARANCE BEFORE CYCLE REPEATS
9235 DATA 5,"ALL RED",1,1,1,1
