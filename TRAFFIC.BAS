1 REM *** AUST. 4-WAY TRAFFIC LIGHTS ***
2 REM *** LEFT-HAND DRIVE SIMULATION ***
3 REM *** FOUR-WAY INTERSECTION       ***
4 REM *** N+S SIGNALS HAVE TURN ARROWS***
5 REM
6 REM SCREEN: 40 COLS x 24 ROWS
7 REM ROAD N/S: | AT COLS 12 AND 16
8 REM ROAD E/W: = AT ROWS 8 AND 12
9 REM
10 HOME
20 GOSUB 900
30 GOSUB 2000
40 CP = 1
50 GOSUB 3000
60 GOSUB 4000
70 GOSUB 5000
80 IF QF = 1 THEN GOTO 500
90 CP = CP + 1
100 IF CP > NP THEN CP = 1
110 GOTO 50
500 HOME
510 VTAB 12 : HTAB 10
520 PRINT "SIMULATION ENDED"
530 END
900 REM READ SIGNAL HEAD CONFIG
910 READ NH
920 DIM HR(NH),HC(NH),HA(NH)
930 FOR I = 1 TO NH
940 READ HR(I),HC(I),HA(I)
950 NEXT I
960 REM READ PHASE CONFIG
970 READ NP
980 DIM PD(NP),PN$(NP),PS(NP,NH)
990 FOR P = 1 TO NP
1000 READ PD(P),PN$(P)
1010 FOR H = 1 TO NH
1020 READ PS(P,H)
1030 NEXT H
1040 NEXT P
1050 RETURN
2000 REM DRAW STATIC SCREEN
2010 HOME
2020 VTAB 1 : HTAB 9
2030 PRINT "AUST. TRAFFIC LIGHT SIM"
2040 VTAB 3 : HTAB 1 : PRINT "N:"
2050 VTAB 17 : HTAB 1 : PRINT "S:"
2060 FOR R = 4 TO 7
2070 VTAB R : HTAB 12 : PRINT "|   |"
2080 NEXT R
2090 VTAB 8 : HTAB 1
2100 PRINT "===========+===+========================"
2110 FOR R = 9 TO 11
2120 VTAB R : HTAB 12 : PRINT "|   |"
2130 NEXT R
2140 VTAB 12 : HTAB 1
2150 PRINT "===========+===+========================"
2160 FOR R = 13 TO 16
2170 VTAB R : HTAB 12 : PRINT "|   |"
2180 NEXT R
2190 VTAB 10 : HTAB 9 : PRINT "W"
2200 VTAB 10 : HTAB 18 : PRINT "E"
2210 VTAB 22 : HTAB 1
2220 PRINT "PRESS ANY KEY TO STOP"
2230 RETURN
3000 REM DRAW ALL SIGNAL HEADS
3010 REM STATES: 1=RED 2=AMBER 3=GREEN 4=ARROW 5=RED+AMBER
3020 REM ARROWS: SA=1 PRINTS < (WEST)  SA=2 PRINTS > (EAST)
3030 FOR DH = 1 TO NH
3040 SR = HR(DH) : SC = HC(DH) : SA = HA(DH) : SS = PS(CP,DH)
3050 VTAB SR : HTAB SC
3060 REM RED LAMP: LIT FOR STATES 1, 4, 5
3070 IF SS = 1 OR SS = 4 OR SS = 5 THEN INVERSE
3080 PRINT "O"; : NORMAL : PRINT "  ";
3090 REM AMBER LAMP: LIT FOR STATES 2, 5
3100 IF SS = 2 OR SS = 5 THEN INVERSE
3110 PRINT "O"; : NORMAL : PRINT "  ";
3120 REM GREEN LAMP: LIT FOR STATE 3
3130 IF SS = 3 THEN INVERSE
3140 PRINT "O"; : NORMAL
3150 REM ARROW LAMP: ONLY ON HEADS WITH HA>0, LIT ONLY FOR STATE 4
3160 IF SA > 0 THEN PRINT "  ";
3170 IF SA > 0 AND SS = 4 THEN INVERSE
3180 IF SA = 1 THEN PRINT "<";
3190 IF SA = 2 THEN PRINT ">";
3200 IF SA > 0 THEN NORMAL
3210 NEXT DH
3220 RETURN
4000 REM SHOW CURRENT PHASE NAME
4010 VTAB 20 : HTAB 1
4020 PRINT "PHASE: ";PN$(CP);"          "
4030 RETURN
5000 REM TIMED DELAY WITH KEYPRESS CHECK
5010 QF = 0
5020 FOR T = 1 TO PD(CP) * 200
5030 IF PEEK(49152) > 127 THEN POKE 49168,0 : QF = 1 : T = PD(CP) * 200
5040 NEXT T
5050 RETURN
9000 REM *** SIGNAL HEAD CONFIGURATION ***
9005 REM NH = NUMBER OF SIGNAL HEADS
9010 REM FORMAT PER HEAD: ROW, BASE_COL, ARROW_TYPE
9015 REM ARROW_TYPE: 0=NONE  1=< (TURN WEST)  2=> (TURN EAST)
9020 REM LAMP COLS: BASE, BASE+3, BASE+6, BASE+9 (IF ARROW)
9025 DATA 4
9030 REM SIG 1: NORTH APPROACH - SOUTHBOUND DRIVERS, RIGHT TURN = WEST (<)
9035 DATA 3,4,1
9040 REM SIG 2: SOUTH APPROACH - NORTHBOUND DRIVERS, RIGHT TURN = EAST (>)
9045 DATA 17,4,2
9050 REM SIG 3: WEST APPROACH - EASTBOUND DRIVERS, NO PROTECTED TURN
9055 DATA 10,1,0
9060 REM SIG 4: EAST APPROACH - WESTBOUND DRIVERS, NO PROTECTED TURN
9065 DATA 10,21,0
9070 REM *** PHASE CONFIGURATION ***
9075 REM NP = NUMBER OF PHASES
9080 REM FORMAT: DURATION, NAME, N_ST, S_ST, W_ST, E_ST
9085 REM STATES: 1=RED  2=AMBER  3=GREEN  4=ARROW  5=RED+AMBER
9090 REM SIGNAL ORDER IN EACH PHASE: NORTH, SOUTH, WEST, EAST
9095 DATA 12
9100 REM PHASE 1: N-S PREPARE (RED+AMBER = AUSTRALIAN PRE-GREEN SIGNAL)
9105 DATA 5,"NS PREP",5,5,1,1
9110 REM PHASE 2: N-S GREEN - STRAIGHT AHEAD AND FREE LEFT TURNS
9115 DATA 50,"NS GREEN",3,3,1,1
9120 REM PHASE 3: N-S AMBER - PREPARE TO STOP
9125 DATA 15,"NS AMBER",2,2,1,1
9130 REM PHASE 4: ALL RED CLEARANCE INTERVAL
9135 DATA 5,"ALL RED",1,1,1,1
9140 REM PHASE 5: NORTH ARROW - PROTECTED RIGHT TURN (SOUTHBOUND TO WEST)
9145 DATA 20,"N ARROW",4,1,1,1
9150 REM PHASE 6: ALL RED CLEARANCE
9155 DATA 5,"ALL RED",1,1,1,1
9160 REM PHASE 7: SOUTH ARROW - PROTECTED RIGHT TURN (NORTHBOUND TO EAST)
9165 DATA 20,"S ARROW",1,4,1,1
9170 REM PHASE 8: ALL RED CLEARANCE
9175 DATA 5,"ALL RED",1,1,1,1
9180 REM PHASE 9: E-W PREPARE (RED+AMBER = AUSTRALIAN PRE-GREEN SIGNAL)
9185 DATA 5,"EW PREP",1,1,5,5
9190 REM PHASE 10: E-W GREEN - STRAIGHT AHEAD AND FREE LEFT TURNS
9195 DATA 50,"EW GREEN",1,1,3,3
9200 REM PHASE 11: E-W AMBER - PREPARE TO STOP
9205 DATA 15,"EW AMBER",1,1,2,2
9210 REM PHASE 12: ALL RED CLEARANCE BEFORE CYCLE REPEATS
9215 DATA 5,"ALL RED",1,1,1,1
