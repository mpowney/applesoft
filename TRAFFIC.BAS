1 REM *** AUST. 4-WAY TRAFFIC LIGHTS ***
2 REM *** LEFT-HAND TRAFFIC SIMULATION
3 REM *** HORIZONTAL SIGNAL DISPLAY
4 REM *** RANDOM ARROW ACTIVATION LOOP
5 REM
6 REM SCREEN: 40 COLS x 24 ROWS
7 REM LAMPS VERTICAL: RED/AMBER/GREEN
8 REM ARROWS ON SAME ROW AS COLOR LAMP
9 REM
10 HOME
15 RR=5:AR=7:GNR=9
16 DIM ST(4)
20 GOSUB 900
30 GOSUB 2000
35 X=RND(-PEEK(78)-PEEK(79)*256)
40 REM ---- MAIN CYCLE ----
50 NF=INT(RND(1)*2):SF=INT(RND(1)*2)
55 GOSUB 8000
60 ST(1)=5:ST(2)=5:ST(3)=1:ST(4)=1
65 PN$="NS PREP":PD=5:GOSUB 7000
70 IF QF=1 THEN GOTO 500
75 ST(1)=3:ST(2)=3:ST(3)=1:ST(4)=1
80 PN$="NS GREEN":PD=50:GOSUB 7000
85 IF QF=1 THEN GOTO 500
90 ST(1)=2:ST(2)=2:ST(3)=1:ST(4)=1
95 PN$="NS AMBER":PD=15:GOSUB 7000
100 IF QF=1 THEN GOTO 500
105 ST(1)=1:ST(2)=1:ST(3)=1:ST(4)=1
110 PN$="ALL RED":PD=5:GOSUB 7000
115 IF QF=1 THEN GOTO 500
120 REM ---- ARROW SECTION ----
125 IF NF=0 AND SF=0 THEN GOTO 230
130 IF NF=1 AND SF=1 THEN ST(1)=4:ST(2)=4:GOTO 150
135 IF NF=1 THEN ST(1)=7:ST(2)=1
140 IF SF=1 THEN ST(2)=7:ST(1)=1
150 ST(3)=1:ST(4)=1
155 PN$="NS ARROW"
160 IF NF=1 AND SF=0 THEN PN$="N ARROW"
165 IF SF=1 AND NF=0 THEN PN$="S ARROW"
170 PD=20:GOSUB 7000
175 IF QF=1 THEN GOTO 500
180 IF NF=1 THEN ST(1)=6
185 IF NF=0 THEN ST(1)=1
190 IF SF=1 THEN ST(2)=6
195 IF SF=0 THEN ST(2)=1
200 ST(3)=1:ST(4)=1
205 PN$="NS ARW AMB"
210 IF NF=1 AND SF=0 THEN PN$="N ARW AMB"
215 IF SF=1 AND NF=0 THEN PN$="S ARW AMB"
220 PD=8:GOSUB 7000
225 IF QF=1 THEN GOTO 500
226 ST(1)=1:ST(2)=1:ST(3)=1:ST(4)=1
227 PN$="ALL RED":PD=5:GOSUB 7000
228 IF QF=1 THEN GOTO 500
230 REM ---- E-W SECTION ----
235 ST(1)=1:ST(2)=1:ST(3)=5:ST(4)=5
240 PN$="EW PREP":PD=5:GOSUB 7000
245 IF QF=1 THEN GOTO 500
250 ST(1)=1:ST(2)=1:ST(3)=3:ST(4)=3
255 PN$="EW GREEN":PD=50:GOSUB 7000
260 IF QF=1 THEN GOTO 500
265 ST(1)=1:ST(2)=1:ST(3)=2:ST(4)=2
270 PN$="EW AMBER":PD=15:GOSUB 7000
275 IF QF=1 THEN GOTO 500
280 ST(1)=1:ST(2)=1:ST(3)=1:ST(4)=1
285 PN$="ALL RED":PD=5:GOSUB 7000
290 IF QF=1 THEN GOTO 500
295 GOTO 40
500 HOME
510 VTAB 12:HTAB 10
520 PRINT "SIMULATION ENDED"
530 END
900 REM READ SIGNAL HEAD CONFIG
910 READ NH
920 DIM HC(NH),HA(NH)
930 FOR I=1 TO NH
940 READ HC(I),HA(I)
950 NEXT I
960 RETURN
2000 REM DRAW STATIC SCREEN
2010 HOME
2020 VTAB 1:HTAB 9
2030 PRINT "AUST. TRAFFIC LIGHT SIM"
2040 VTAB 3:HTAB 3:PRINT "NORTH";
2050 HTAB 13:PRINT "SOUTH";
2060 HTAB 23:PRINT "WEST";
2070 HTAB 33:PRINT "EAST"
2080 VTAB 22:HTAB 1
2090 PRINT "PRESS ANY KEY TO STOP"
2100 RETURN
3000 REM DRAW ALL SIGNAL HEADS
3005 REM STATES: 1=RED 2=AMB 3=GRN 4=GRN-ARW 5=R+A 6=AMB-ARW 7=GRN+ARW
3010 FOR DH=1 TO NH
3020 SC=HC(DH):SA=HA(DH):SS=ST(DH)
3030 REM RED LAMP (LIT: 1,4,5,6 - RED STAYS ON DURING ARROW PHASES)
3040 VTAB RR:HTAB SC
3050 IF SS=1 OR SS=4 OR SS=5 OR SS=6 THEN INVERSE
3060 PRINT "O":NORMAL
3070 REM AMBER LAMP (LIT: 2,5)
3080 VTAB AR:HTAB SC
3090 IF SS=2 OR SS=5 THEN INVERSE
3100 PRINT "O":NORMAL
3110 REM GREEN LAMP (LIT: 3,7)
3120 VTAB GNR:HTAB SC
3130 IF SS=3 OR SS=7 THEN INVERSE
3140 PRINT "O":NORMAL
3150 REM ARROW LAMPS - ONLY ON HEADS WITH SA>0
3155 IF SA=0 THEN GOTO 3240
3160 REM AMBER ARROW: SAME ROW AS AMBER LAMP (LIT: STATE 6)
3165 VTAB AR:HTAB SC+2
3170 IF SS=6 THEN INVERSE
3175 IF SA=1 THEN PRINT "<"
3180 IF SA=2 THEN PRINT ">"
3185 NORMAL
3190 REM GREEN ARROW: SAME ROW AS GREEN LAMP (LIT: STATES 4,7)
3195 VTAB GNR:HTAB SC+2
3200 IF SS=4 OR SS=7 THEN INVERSE
3205 IF SA=1 THEN PRINT "<"
3210 IF SA=2 THEN PRINT ">"
3215 NORMAL
3240 NEXT DH
3250 RETURN
4000 REM SHOW CURRENT PHASE NAME
4010 VTAB 20:HTAB 1
4020 PRINT "PHASE: ";PN$;"          "
4030 RETURN
5000 REM TIMED DELAY WITH KEYPRESS CHECK
5010 QF=0
5020 FOR T=1 TO PD*200
5030 IF PEEK(49152)>127 THEN POKE 49168,0:QF=1:T=PD*200
5040 NEXT T
5050 RETURN
7000 REM EXECUTE ONE PHASE (USES ST(),PN$,PD)
7010 GOSUB 3000
7020 GOSUB 4000
7030 GOSUB 5000
7040 RETURN
8000 REM SHOW DETECTION LOOP STATUS
8010 VTAB 21:HTAB 1
8020 IF NF=0 THEN PRINT "N-LOOP:-- ";
8025 IF NF=1 THEN INVERSE:PRINT "N-LOOP:ON ";:NORMAL
8030 IF SF=0 THEN PRINT "S-LOOP:--"
8035 IF SF=1 THEN INVERSE:PRINT "S-LOOP:ON":NORMAL
8040 RETURN
9000 REM *** SIGNAL HEAD CONFIGURATION ***
9005 REM NH = NUMBER OF SIGNAL HEADS
9010 REM FORMAT: COL, ARROW_TYPE
9015 REM ARROW_TYPE: 0=NONE  1=< (WEST)  2=> (EAST)
9020 REM LAMP ROWS: RR=RED(5) AR=AMBER(7) GNR=GREEN(9)
9025 DATA 4
9030 REM SIG 1: NORTH APPROACH - SOUTHBOUND DRIVERS, RIGHT TURN = WEST (<)
9035 DATA 5,1
9040 REM SIG 2: SOUTH APPROACH - NORTHBOUND DRIVERS, RIGHT TURN = EAST (>)
9045 DATA 15,2
9050 REM SIG 3: WEST APPROACH - EASTBOUND DRIVERS, NO PROTECTED TURN
9055 DATA 25,0
9060 REM SIG 4: EAST APPROACH - WESTBOUND DRIVERS, NO PROTECTED TURN
9065 DATA 35,0
